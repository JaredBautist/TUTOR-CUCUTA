# 1. Supabase (Base de Datos PostgreSQL + PostGIS)
# Obtén estas credenciales en: Project Settings -> API de tu proyecto Supabase
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"
VITE_SUPABASE_ANON_KEY="tu-anon-key-publica"

# 2. Google Gemini API (Opcional si se habilitan diagnósticos de aprendizaje con IA)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 3. URL de la aplicación
APP_URL="http://localhost:3000"


