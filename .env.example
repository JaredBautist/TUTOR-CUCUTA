# Public Supabase configuration (Vite embeds VITE_ values in the browser bundle).
# Use the project URL and public anon key from Supabase Project Settings > API.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-anon-key"

# No service-role key or provider secret belongs in a VITE_ variable.
# MapLibre/OpenFreeMap requires no map API key.
# Auth redirects use the current browser origin; configure the matching URLs in
# Supabase Auth > URL Configuration. See docs/vercel-readiness.md.
